# Copy to .env. Never commit real credentials.
# Defaults keep the sample app on loopback with file storage.
APP_MODE=demo
PORT=4173
APP_URL=http://127.0.0.1:4173

# For real account sign-in, set APP_MODE=accounts.
# First boot only: creates an administrator if the store is empty.
# BOOTSTRAP_ADMIN_EMAIL=you@example.com
# BOOTSTRAP_ADMIN_NAME=Administrator
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-12-characters

# Optional MongoDB (requires accounts mode and a replica set / Atlas).
# MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
# MONGODB_DATABASE=basketball_experience

# Optional Stripe TEST MODE only. Live keys are deliberately rejected.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Optional provider adapters. Keep secrets on the SERVER only.
# AI accepts a Responses API model that supports strict structured outputs.
# OPENAI_API_KEY=...
# OPENAI_SCHEDULING_MODEL=your-approved-model-id

# Google Drive import: an already-authorized OAuth refresh token with Drive read
# access and a dedicated club video folder. Imports make local copies.
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# GOOGLE_REFRESH_TOKEN=...
# GOOGLE_DRIVE_FOLDER_ID=...

# External delivery is off until explicitly enabled in accounts mode.
# ENABLE_EXTERNAL_DELIVERY=true
# RESEND_API_KEY=...
# EMAIL_FROM=The Basketball Experience <updates@your-verified-domain>
# EXPO_ACCESS_TOKEN=...

# Optional LAN binding for physical-device development. Default remains loopback.
# HOST=0.0.0.0

# Optional server-side private video copies; disabled by default.
# ENABLE_CLOUD_UPLOADS=true
# S3_BUCKET=your-private-bucket
# AWS_REGION=ca-central-1
# Use a scoped IAM role in deployment. Do not put AWS credentials in mobile/web code.
